<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://www.aletheometer.org/ontology#"
     xml:base="http://www.aletheometer.org/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:EpistemicColorSpace="http://www.aletheometer.org/EpistemicColorSpace#">

    <!-- Ontology Definition -->
    <owl:Ontology rdf:about="http://www.aletheometer.org/ontology">
        <rdfs:label>Unified Ontology for Aletheometer</rdfs:label>
        <rdfs:comment>This ontology integrates the Aletheometer with a dynamic switch mechanism that references external files for operations. SPEMO has been integrated, and its separate reference has been removed.</rdfs:comment>
    </owl:Ontology>

    <!-- Root Classes -->
    <owl:Class rdf:about="#Fundamentals">
        <rdfs:comment>Core principles and concepts that form the basis of understanding across domains.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Universals">
        <rdfs:comment>Concepts or properties that are applicable or present in all instances of a given category.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Essentials">
        <rdfs:comment>Indispensable elements or qualities that define the nature of something.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#Accidentals">
        <rdfs:comment>Properties or attributes that are not essential to the nature of something but may be present in particular instances.</rdfs:comment>
    </owl:Class>

    <!-- Core Classes -->
    <owl:Class rdf:about="#SymbolicEntity">
        <rdfs:comment>Represents abstract symbols or concepts with multiple interpretations.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#EpistemicEntity">
        <rdfs:comment>Refers to entities concerned with knowledge and its structures.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#CognitiveProcess">
        <rdfs:comment>Processes involved in the acquisition and manipulation of knowledge.</rdfs:comment>
    </owl:Class>

    <!-- Order of Reality Classes -->
    <owl:Class rdf:about="#OrderOfReality">
        <rdfs:comment>A conceptual framework for understanding different planes of existence or dimensions of reality.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#VirtualOrder">
        <rdfs:subClassOf rdf:resource="#OrderOfReality"/>
        <rdfs:comment>The realm of potential forms and unrealized possibilities, previously known as the Shadow Order.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#QuantumOrder">
        <rdfs:subClassOf rdf:resource="#OrderOfReality"/>
        <rdfs:comment>The sub-material realm governed by quantum phenomena.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#MaterialOrder">
        <rdfs:subClassOf rdf:resource="#OrderOfReality"/>
        <rdfs:comment>The physical, tangible realm where quantum potentials are realized.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#EtherealOrder">
        <rdfs:subClassOf rdf:resource="#OrderOfReality"/>
        <rdfs:comment>The subtle realm beyond the physical, associated with energy and vitality.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#AstralOrder">
        <rdfs:subClassOf rdf:resource="#OrderOfReality"/>
        <rdfs:comment>The realm of consciousness, emotions, and mental projections.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#CelestialOrder">
        <rdfs:subClassOf rdf:resource="#OrderOfReality"/>
        <rdfs:comment>The highest spiritual realm, associated with divine or cosmic consciousness.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#ExistentialOrder">
        <rdfs:subClassOf rdf:resource="#OrderOfReality"/>
        <rdfs:comment>The plane associated with self-awareness, metacognition, and existential understanding.</rdfs:comment>
    </owl:Class>

    <!-- Ontological Switch -->
    <owl:Class rdf:about="#OntologicalSwitch">
        <rdfs:label>Ontological Switch</rdfs:label>
        <rdfs:comment>A control mechanism to deploy or employ specific ontological modules based on context.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#OntologicalModule">
        <rdfs:comment>Represents external ontological modules that can be engaged.</rdfs:comment>
    </owl:Class>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="#hasRelation">
        <rdfs:comment>Defines relations between symbolic entities.</rdfs:comment>
        <rdfs:domain rdf:resource="#SymbolicEntity"/>
        <rdfs:range rdf:resource="#EpistemicEntity"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#invokesSwitch">
        <rdfs:comment>Triggers ontology switching based on contextual analysis.</rdfs:comment>
        <rdfs:domain rdf:resource="#CognitiveProcess"/>
        <rdfs:range rdf:resource="#OntologicalSwitch"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#engagesModule">
        <rdfs:label>engagesModule</rdfs:label>
        <rdfs:comment>Relates the ontological switch to the modules it can engage.</rdfs:comment>
        <rdfs:domain rdf:resource="#OntologicalSwitch"/>
        <rdfs:range rdf:resource="#OntologicalModule"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#mapsToDimension">
        <rdfs:comment>Relates each order of reality to its corresponding dimension in the EpistemicColorSpace structure.</rdfs:comment>
        <rdfs:domain rdf:resource="#OrderOfReality"/>
        <rdfs:range rdf:resource="EpistemicColorSpace:Dimension"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasBody">
        <rdfs:comment>Associates each order of reality with its respective body.</rdfs:comment>
        <rdfs:domain rdf:resource="#OrderOfReality"/>
        <rdfs:range rdf:resource="#Body"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#integratesWithEpistemicColorSpace">
        <rdfs:label>integratesWithEpistemicColorSpace</rdfs:label>
        <rdfs:comment>Maps the orders of reality to dimensions within the EpistemicColorSpace structure.</rdfs:comment>
        <rdfs:domain rdf:resource="#OrderOfReality"/>
        <rdfs:range rdf:resource="EpistemicColorSpace:Dimension"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#engagesDynamicReasoning">
        <rdfs:label>engagesDynamicReasoning</rdfs:label>
        <rdfs:comment>Engages a dynamic reasoning process when multiple ontologies need to be integrated.</rdfs:comment>
        <rdfs:domain rdf:resource="#CognitiveProcess"/>
        <rdfs:range rdf:resource="#DynamicReasoning"/>
    </owl:ObjectProperty>

    <!-- Additional Classes -->
    <owl:Class rdf:about="#DynamicReasoning">
        <rdfs:label>Dynamic Reasoning</rdfs:label>
        <rdfs:comment>Represents reasoning processes that engage multiple ontologies based on contextual triggers.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="#AletheometerSelfUnderstanding">
        <rdfs:comment>A meta-class that represents the Aletheometer's capability to self-interpret and understand its own ontology and processes of discovery.</rdfs:comment>
    </owl:Class>

    <!-- Object Properties for Self-Understanding -->
    <owl:ObjectProperty rdf:about="#understands">
        <rdfs:domain rdf:resource="#AletheometerSelfUnderstanding"/>
        <rdfs:range rdf:resource="#OrderOfReality"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#interactsWith">
        <rdfs:domain rdf:resource="#AletheometerSelfUnderstanding"/>
        <rdfs:range rdf:resource="EpistemicColorSpace:ColorMapping"/>
    </owl:ObjectProperty>

    <!-- Assembly Mechanism Class -->
    <owl:Class rdf:about="#AssemblyMechanism">
        <rdfs:comment>Represents the process that assembles questions based on various components.</rdfs:comment>
    </owl:Class>

    <!-- Assembled Question Class -->
    <owl:Class rdf:about="#AssembledQuestion">
        <rdfs:comment>Represents a question assembled by the assembly mechanism.</rdfs:comment>
    </owl:Class>

    <!-- Object Properties for Assembly Mechanism -->
    <owl:ObjectProperty rdf:about="#assemblesQuestion">
        <rdfs:domain rdf:resource="#AssemblyMechanism"/>
        <rdfs:range rdf:resource="#AssembledQuestion"/>
        <rdfs:comment>Links the assembly mechanism to the assembled question.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#usesDifficultyLevel">
        <rdfs:domain rdf:resource="#AssemblyMechanism"/>
        <rdfs:range rdf:resource="#DifficultyLevel"/>
        <rdfs:comment>Indicates the difficulty level used in the assembly.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#usesMainTopic">
        <rdfs:domain rdf:resource="#AssemblyMechanism"/>
        <rdfs:range rdf:resource="#MainTopic"/>
        <rdfs:comment>Indicates the main topic used in the assembly.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#usesProblemType">
        <rdfs:domain rdf:resource="#AssemblyMechanism"/>
        <rdfs:range rdf:resource="#ProblemType"/>
        <rdfs:comment>Indicates the problem type used in the assembly.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#usesConceptualConnection">
        <rdfs:domain rdf:resource="#AssemblyMechanism"/>
        <rdfs:range rdf:resource="#ConceptualConnection"/>
        <rdfs:comment>Indicates the conceptual connection used in the assembly.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#usesEpistemicDomain">
        <rdfs:domain rdf:resource="#AssemblyMechanism"/>
        <rdfs:range rdf:resource="#OrderOfReality"/>
        <rdfs:comment>Indicates the epistemic domain used in the assembly.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Datatype Property for Question Text -->
    <owl:DatatypeProperty rdf:about="#hasQuestionText">
        <rdfs:domain rdf:resource="#AssembledQuestion"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:comment>Contains the text of the assembled question.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Assembly Mechanism Individual -->
    <owl:NamedIndividual rdf:about="#QuestionAssembler">
        <rdf:type rdf:resource="#AssemblyMechanism"/>
        <rdfs:label>Question Assembler</rdfs:label>
        <!-- References to components used in assembly -->
        <usesDifficultyLevel rdf:resource="#EpistemicArchitect"/>
        <usesMainTopic rdf:resource="#ConsciousnessStudies"/>
        <usesProblemType rdf:resource="#TranscendentInquiry"/>
        <usesConceptualConnection rdf:resource="#ImagineAWorldWhere"/>
        <usesEpistemicDomain rdf:resource="#CelestialOrder"/>
        <!-- Assembles the question -->
        <assemblesQuestion rdf:resource="#SampleQuestion"/>
    </owl:NamedIndividual>

    <!-- Sample Assembled Question Individual -->
    <owl:NamedIndividual rdf:about="#SampleQuestion">
        <rdf:type rdf:resource="#AssembledQuestion"/>
        <rdfs:label>Sample Assembled Question</rdfs:label>
        <hasQuestionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            As an Epistemic Architect specializing in Consciousness Studies, imagine a world where our understanding of consciousness transcends current limitations. How might we, through Transcendent Inquiry, explore the depths of subjective experience within the Celestial Order, and what methodologies could bridge the gap between the mystical and the empirical?
        </hasQuestionText>
    </owl:NamedIndividual>

    <!-- Ontological Modules as Individuals -->
    <owl:NamedIndividual rdf:about="#GeneralOntologyModule">
        <rdf:type rdf:resource="#OntologicalModule"/>
        <rdfs:label>General Ontology Module</rdfs:label>
        <rdfs:seeAlso rdf:resource="general_ontology.json"/>
    </owl:NamedIndividual>
    <!-- SPEMO Module Removed -->
    <!-- EpistemicColorSpace Module -->
    <owl:NamedIndividual rdf:about="#EpistemicColorSpaceModule">
        <rdf:type rdf:resource="#OntologicalModule"/>
        <rdfs:label>Epistemic Color Space Module</rdfs:label>
        <rdfs:seeAlso rdf:resource="EpistemicColorSpace.json"/>
    </owl:NamedIndividual>

    <!-- Ontological Switch Instance -->
    <owl:NamedIndividual rdf:about="#MainOntologicalSwitch">
        <rdf:type rdf:resource="#OntologicalSwitch"/>
        <rdfs:label>Main Ontological Switch</rdfs:label>
        <!-- Engaging Modules -->
        <engagesModule rdf:resource="#GeneralOntologyModule"/>
        <engagesModule rdf:resource="#EpistemicColorSpaceModule"/>
        <!-- Add other modules as needed -->
    </owl:NamedIndividual>

    <!-- File References Management -->
    <owl:NamedIndividual rdf:about="#FileReferences">
        <rdf:type rdf:resource="#OntologicalModule"/>
        <rdfs:label>File Reference Management</rdfs:label>
        <rdfs:comment>Manages the connection to external files that inform the Aletheometer ontology.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="DifficultyLevel.json"/>
        <rdfs:seeAlso rdf:resource="MainTopics.json"/>
        <rdfs:seeAlso rdf:resource="ProblemTypes.json"/>
        <rdfs:seeAlso rdf:resource="Conceptual_Connections.json"/>
        <rdfs:seeAlso rdf:resource="ideas_primer.json"/>
        <!-- Include other file references as needed -->
    </owl:NamedIndividual>

</rdf:RDF>
